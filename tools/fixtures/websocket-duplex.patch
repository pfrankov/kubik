  *       This function does NOT acquire the lock itself. Calling without the lock will result in
  *       race conditions and undefined behavior.
  */
+// Lock order: CLIENT -> TX. Link drains its public senders before stop/destroy.
+static void close_transport(esp_websocket_client_handle_t client)
+{
+    atomic_store(&client->send_ready, false);
+    xSemaphoreTakeRecursive(client->tx_lock, portMAX_DELAY);
+    esp_transport_close(client->transport);
+    xSemaphoreGiveRecursive(client->tx_lock);
+}
