+static esp_err_t cst9217_get_track_id(esp_lcd_touch_handle_t tp, uint8_t *ids, uint8_t count)
+{
+    portENTER_CRITICAL(&tp->data.lock);
+    if (count > tp->data.points) {
+        portEXIT_CRITICAL(&tp->data.lock);
+        return ESP_ERR_INVALID_ARG;
+    }
+    for (uint8_t i = 0; i < count; i++) ids[i] = tp->data.coords[i].track_id;
+    portEXIT_CRITICAL(&tp->data.lock);
+    return ESP_OK;
+}
